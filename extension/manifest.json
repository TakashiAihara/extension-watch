{
  "manifest_version": 3,
  "name": "extension-watch",
  "version": "0.1.0",
  "description": "Notify ntfy when installed extensions are added, updated, change permissions, or get disabled.",
  "permissions": [
    "management",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "extension-watch",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "storage": {
    "managed_schema": "schema.json"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
